layout {
    gaps 4                          // 像素为单位设置窗口周围的间隙
    center-focused-column "never"   // 切换焦点时居中列：无特殊居中
    preset-column-widths {          // 设置列的宽度：1/3, 1/2, 2/3, 100%
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }

    default-column-width { proportion 0.66667; } // 设置默认列的宽度

    focus-ring {                // 焦点环设置（活动窗口）
        off
    }

    border {                    // 边框设置（所有窗口）
        width 2
        active-gradient from="#0DB7D4" to="#9778D0" angle=90
        inactive-color "#04404A"
    }

    background-color "transparent"     // 背景色：透明

    struts {                        // 外部间隙：像素
        left 2
        right 2
        top 2
        bottom 2
    }
}

layer-rule {                           // 层规则
    match namespace="^(swww|awww)-daemon$"    // 匹配命名空间（swww 已改名 awww）
    place-within-backdrop true         // 表面放置在在概览和工作区之间可见的背景中
}
