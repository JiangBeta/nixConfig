# ==========================================
# zshrc 配置文件
# 版本：5.9.2
# 更新时间：2026年7月
# 文件位置：~/.zshrc
# ==========================================

# ---------- 1. 初始化 ----------
## 补全系统（通常放在 .zshrc 开头）
if type brew &>/dev/null; then
  FPATH="$(brew --prefix)/share/zsh-completions:$FPATH"
fi
autoload -Uz compinit && compinit -C

## zoxide 排除目录（需在初始化前）
export _ZO_DATA_DIR="$HOME/.local/share/zoxide"  # 数据库路径
export _ZO_EXCLUDE_DIRS="$HOME/tmp:$HOME/Downloads/*:/home/.snapshots/*"  # 排除路径
export _ZO_RESOLVE_SYMLINKS=1                    # 启用符号链接解析

## 工具初始化（按需加载）
eval "$(zoxide init zsh)"               # 智能目录跳转
# eval "$(fnm env --use-on-cd)"         # Node.js 版本管理
eval "$(starship init zsh)"             # zsh 提示符（Prompt）
eval "$(sheldon source)"                # zsh 插件（Plugins）
source <(fzf --zsh)                     # FZF 初始化
source /usr/share/fzf/key-bindings.zsh  # FZF 按键绑定
source /usr/share/fzf/completion.zsh    # FZF 自动补全

# ---------- 2. 环境变量 ----------
## 路径配置：将自定义工具目录加入 PATH（优先级高于系统默认）
export PATH="$HOME/bin:$HOME/.local/bin:$PATH"
export STARSHIP_CONFIG="$HOME/.config/anyconf/starship.toml"  # starship配置文件
export BAT_CONFIG_PATH="$HOME/.config/anyconf/bat.conf"       # bat 配置文件

## 语言与编码（避免中文乱码）
export LANG="zh_CN.UTF-8"
export LC_ALL="zh_CN.UTF-8"

## 编辑器配置：设置默认文本编辑器为 VS Code
export EDITOR="code --wait"
export VISUAL="code --wait"

## Node.js 环境（pnpm）
export PNPM_HOME="$HOME/Library/pnpm"
export PATH="$PNPM_HOME:$PATH"

# ---------- 3. 软件相关 ----------
## Yazi 文件管理器（退出时 cd）
function y() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
	command yazi "$@" --cwd-file="$tmp"
	IFS= read -r -d '' cwd < "$tmp"
	[ "$cwd" != "$PWD" ] && [ -d "$cwd" ] && builtin cd -- "$cwd"
	command rm -f -- "$tmp"
}

## FZF
### 限制最大搜索深度
export FZF_WALKER_DEPTH=5
### 调整窗口高度为60%
export FZF_TMUX_HEIGHT="60%"
### 默认启用预览窗口
export FZF_DEFAULT_OPTS="--preview 'cat {}' --preview-window right:50%"
### 历史命令搜索时忽略大小写
export FZF_CTRL_R_OPTS="--scheme=history -i"
### 代码文件显示语法高亮，目录显示树形结构
export FZF_CTRL_T_OPTS="--preview '[[ -d {} ]] && tree -C {} || highlight -0 ansi {} 2> /dev/null'"

## zoxide + fzf 模糊搜索
zx() {
  local query="${*}"
  local dir

  dir=$(zoxide query --list --score | \
    fzf --filter="$query" --no-sort | \
    fzf \
      --prompt="zoxide > " \
      --nth=2.. \
      --ansi \
      --height=60% \
      --info=inline \
      --border=rounded \
      --layout=reverse \
      --preview-window=down:40%:wrap \
      --preview='ls -F -C --color=always {2..}' \
   --bind 'ctrl-z:ignore,btab:up,tab:down,enter:become:echo {2..}' \
      --cycle \
      --keep-right \
      --tabstop=1
  )

  [[ -n "$dir" ]] && cd "$dir"
}

## fastfetch 启动且不在 VSCode terminal 或 nvim 中启动
if [[ "$TERM_PROGRAM" != "vscode" && -z "$VSCODE_INJECTION" && -z "$NVIM" ]]; then
  fastfetch --pipe false
fi

# ---------- 4. 别名 ----------
## exa 替代 ls
alias ls="exa --icons --long --header"              # 显示文件目录详情
alias ll="exa --icons --long --header --all"        # 显示文件目录详情，包括隐藏文件
alias lg="exa --icons --long --header --all --git"  # 显示详情的同时，附带 git 状态信息
alias tree="exa --tree --icons"                     # 替换 tree 命令

## bat 替代 cat 
alias cat="bat"

## lazygit 简写
alias lg="lazygit"

## dust 替代 du
alias du="dust"
